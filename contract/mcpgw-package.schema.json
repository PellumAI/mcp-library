{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PellumAI/MCPGW/releases/download/mcpgw-package.schema.json",
  "title": "mcpgw-package.json",
  "description": "The manifest at the root of an MCPGW package tar. Authored in MCPGW and consumed by PellumAI/mcp-library at a pinned release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "title",
    "runtime",
    "os",
    "arch",
    "entrypoint",
    "transport",
    "path",
    "resources"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "runtime": { "type": "string", "pattern": "^(node@[0-9]+|python@[0-9]+\\.[0-9]+|native)$" },
    "os": { "type": "string", "enum": ["linux"] },
    "arch": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["amd64", "arm64"] }
    },
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^ \\t\\n\\r]+$" }
    },
    "transport": { "type": "string", "enum": ["stdio", "http"] },
    "path": { "type": "string", "pattern": "^/" },
    "stateless": { "type": "boolean" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
    "gateway_auth": { "oneOf": [{ "$ref": "#/$defs/gateway_auth" }, { "type": "null" }] },
    "upstream_auth": { "oneOf": [{ "$ref": "#/$defs/upstream_auth" }, { "type": "null" }] },
    "egress": { "type": "array", "items": { "$ref": "#/$defs/egress_rule" } },
    "resources": { "$ref": "#/$defs/resources" },
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "health": { "$ref": "#/$defs/health" }
  },
  "$defs": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "int", "bool", "enum"] },
        "description": { "type": "string" },
        "env": { "type": "string", "pattern": "^([A-Z_][A-Z0-9_]*)?$" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "default": { "type": "string" },
        "enum": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gateway_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "method": { "type": "string", "enum": ["bearer_token", "api_key_header"] },
        "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "header": { "type": "string" },
        "scheme": { "type": "string" }
      }
    },
    "upstream_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "param"],
      "properties": {
        "method": { "type": "string", "enum": ["bearer_token", "api_key_header"] },
        "param": { "type": "string", "minLength": 1 },
        "header": { "type": "string" }
      }
    },
    "egress_rule": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["host"] }, { "required": ["cidr"] }],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "cidr": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "reason": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_max", "pids_max"],
      "properties": {
        "cpu_max": { "type": "string", "pattern": "^(max|[0-9]+ [0-9]+)$" },
        "memory_max": { "type": "string", "pattern": "^[0-9]+(K|M|G|Ki|Mi|Gi)?$" },
        "pids_max": { "type": "integer", "minimum": 1 }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialize_timeout": { "type": "string" }
      }
    }
  }
}
